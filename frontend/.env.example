# Frontend environment variables (copy to .env, never commit a real .env)
# API base URL — defaults to http://localhost:8000/api when unset.
VITE_API_BASE_URL=http://localhost:8000/api
# Stripe publishable key (TEST key only). The placeholder below is not a
# working key; replace it with your own Stripe test publishable key.
VITE_STRIPE_PUBLIC_KEY=pk_test_your_test_key_here
